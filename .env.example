# =============================================================================
# Fichier d'environnement - Application de transcription audio (français)
# Copier ce fichier en ".env" et adapter les valeurs avant le premier lancement.
# =============================================================================

# --- Compte administrateur créé automatiquement au premier démarrage ---
# Identifiant (les comptes utilisent un simple identifiant, pas d'email).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=changeme

# --- Backend / sécurité ---
# Générer une valeur aléatoire forte, ex: openssl rand -hex 32
JWT_SECRET=change_this_secret_before_deploying
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Limites par défaut (modifiables ensuite depuis le panneau admin) ---
# NOTE : le reverse proxy (Nginx interne du frontend + Apache externe, voir
# reverse-proxy/) autorise par défaut jusqu'à 300 Mo par requête, pour
# laisser de la marge si un administrateur augmente cette limite depuis le
# panneau d'administration sans avoir à reconfigurer l'infrastructure. Si
# vous dépassez 300 Mo, pensez à ajuster aussi client_max_body_size
# (frontend/nginx.conf) et LimitRequestBody (reverse-proxy/apache-*.conf).
DEFAULT_MAX_FILE_SIZE_MB=200
DEFAULT_MAX_DURATION_MIN=60

# --- Whisper ---
DEFAULT_WHISPER_MODEL=small
WHISPER_ENGINE=faster-whisper
WHISPER_MODELS_PATH=/models
WHISPER_COMPUTE_TYPE=int8

# --- Base de données SQLite (chemin dans le volume partagé) ---
SQLITE_PATH=/data/app.db

# --- Stockage temporaire des fichiers audio uploadés (purgés après traitement) ---
AUDIO_TMP_PATH=/audio_tmp

# --- Stockage des transcriptions générées (.vtt) ---
TRANSCRIPTS_PATH=/transcripts

# --- Traduction (service translation-worker) ---
# Modèles OPUS-MT (CTranslate2) téléchargés à la demande, un par direction.
TRANSLATION_MODELS_PATH=/translation_models
# Archives ZIP uploadées (supprimées après traitement).
TRANSLATION_TMP_PATH=/translation_tmp
# Résultats produits (archives traduites).
TRANSLATIONS_PATH=/translations

# --- Réseau interne (ports exposés uniquement en interne, le reverse proxy Apache gère l'exposition externe) ---
BACKEND_INTERNAL_PORT=8000
FRONTEND_INTERNAL_PORT=80

# Port sur lequel le conteneur frontend est exposé sur l'hôte (127.0.0.1
# uniquement, voir docker-compose.yml). C'est ce port que le reverse proxy
# Apache doit cibler dans reverse-proxy/apache-transcription.conf.
FRONTEND_HOST_PORT=8080

# --- CORS (origine du frontend, à adapter selon nom de domaine réel en prod) ---
CORS_ORIGINS=http://localhost,https://transcription.example.com
