# =============================================================================
# Environment file - TransTooLing application
# Copy this file to ".env" and adapt the values before the first launch.
# =============================================================================

# --- Administrator account created automatically on first startup ---
# Simple login (accounts use a plain login, not an email).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=changeme

# --- Backend / security ---
# Generate a strong random value, e.g. openssl rand -hex 32
JWT_SECRET=change_this_secret_before_deploying
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Default limits (editable later from the admin panel) ---
# NOTE: the reverse proxy (frontend's internal Nginx + external Apache, see
# reverse-proxy/) allows up to 300 MB per request by default, to leave headroom
# if an administrator raises this limit from the admin panel without having to
# reconfigure the infrastructure. Beyond 300 MB, also adjust
# client_max_body_size (frontend/nginx.conf) and LimitRequestBody
# (reverse-proxy/apache-*.conf).
DEFAULT_MAX_FILE_SIZE_MB=200
DEFAULT_MAX_DURATION_MIN=60

# --- Whisper ---
DEFAULT_WHISPER_MODEL=small
WHISPER_ENGINE=faster-whisper
WHISPER_MODELS_PATH=/models
WHISPER_COMPUTE_TYPE=int8

# --- SQLite database (path inside the shared volume) ---
SQLITE_PATH=/data/app.db

# --- Temporary storage of uploaded audio files (deleted after processing) ---
AUDIO_TMP_PATH=/audio_tmp

# --- Storage of generated transcriptions (.vtt) ---
TRANSCRIPTS_PATH=/transcripts

# --- Translation (translation-worker service) ---
# OPUS-MT (CTranslate2) models downloaded on demand.
TRANSLATION_MODELS_PATH=/translation_models
# Uploaded ZIP archives (deleted after processing).
TRANSLATION_TMP_PATH=/translation_tmp
# Produced results (translated archives).
TRANSLATIONS_PATH=/translations

# --- Internal network (ports only exposed internally, the external Apache reverse proxy handles public exposure) ---
BACKEND_INTERNAL_PORT=8000
FRONTEND_INTERNAL_PORT=80

# Port on which the frontend container is exposed on the host (127.0.0.1
# only, see docker-compose.yml). This is the port the Apache reverse proxy
# must target in reverse-proxy/apache-transcription.conf.
FRONTEND_HOST_PORT=8080

# --- CORS (frontend origin, adapt to the real production domain) ---
CORS_ORIGINS=http://localhost,https://transcription.example.com
